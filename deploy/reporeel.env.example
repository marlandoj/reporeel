# Preparation defaults: no paid generation, no public listener, no secrets.
RENDER_DISABLED=1
REPOREEL_AI_DAILY=0
REPOREEL_BIND=127.0.0.1
PORT=3901
REPOREEL_DATA_DIR=/var/lib/reporeel
HOME=/var/cache/reporeel
XDG_CACHE_HOME=/var/cache/reporeel
REPOREEL_RATE_LIMIT=3
REPOREEL_MAX_QUEUE=3
REPOREEL_MAX_REWRITES=3
REPOREEL_AI_CONCURRENCY=1
REPOREEL_STE_DAILY=20
REPOREEL_RETENTION_DAYS=30
REPOREEL_MAX_STORAGE_MB=1500
# Set only after selecting a proxy that overwrites X-Real-IP:
# REPOREEL_TRUSTED_PROXIES=127.0.0.1,::1
# OPENROUTER_API_KEY must be supplied only through an approved secret path.
# Do not copy desktop credentials or set GH_TOKEN.
